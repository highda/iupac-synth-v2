// Input for scripts/layout-slots.py (#69, widened by #109): the complete eligible-edge graph of the
// fixed editor slot set. Columns are pinned with rank=same so dot only decides the vertical order
// and spacing inside each column. Sizes are inches; the script rescales into 1000x700.
//
// D8 adds the dedicated sub slot to the source column and the four-slot effects region in its own
// band between the mixers and the OUT bus. The effects region is the global post-mixer tail, so it
// has no edge back into a per-voice slot: FX slots feed each other and the OUT bus only.
digraph slots {
    rankdir=LR;
    ranksep=0.6;
    nodesep=0.2;
    splines=false;
    node [shape=box, fixedsize=true, width=1.35, height=1.6];

    { rank=same; SRC1; SRC2; SRC3; SUB; }
    { rank=same; RES1; RES2; }
    { rank=same; FILT1; FILT2; }
    { rank=same; SHAPE1; SHAPE2; }
    { rank=same; MIX1; MIX2; }
    { rank=same; FX1; FX2; FX3; FX4; }
    { rank=same; OUT [width=0.75, height=1.6]; }

    // sources -> every processor, the effects region and the OUT bus
    SRC1 -> {RES1 RES2 FILT1 FILT2 SHAPE1 SHAPE2 MIX1 MIX2 FX1 FX2 FX3 FX4 OUT};
    SRC2 -> {RES1 RES2 FILT1 FILT2 SHAPE1 SHAPE2 MIX1 MIX2 FX1 FX2 FX3 FX4 OUT};
    SRC3 -> {RES1 RES2 FILT1 FILT2 SHAPE1 SHAPE2 MIX1 MIX2 FX1 FX2 FX3 FX4 OUT};
    SUB -> {RES1 RES2 FILT1 FILT2 SHAPE1 SHAPE2 MIX1 MIX2 FX1 FX2 FX3 FX4 OUT};
    // processors -> every other processor, the effects region and the OUT bus (backward runs are
    // legal in the patch as long as the graph stays acyclic; the router returns them below the field)
    RES1 -> {RES2 FILT1 FILT2 SHAPE1 SHAPE2 MIX1 MIX2 FX1 FX2 FX3 FX4 OUT};
    RES2 -> {RES1 FILT1 FILT2 SHAPE1 SHAPE2 MIX1 MIX2 FX1 FX2 FX3 FX4 OUT};
    FILT1 -> {RES1 RES2 FILT2 SHAPE1 SHAPE2 MIX1 MIX2 FX1 FX2 FX3 FX4 OUT};
    FILT2 -> {RES1 RES2 FILT1 SHAPE1 SHAPE2 MIX1 MIX2 FX1 FX2 FX3 FX4 OUT};
    SHAPE1 -> {RES1 RES2 FILT1 FILT2 SHAPE2 MIX1 MIX2 FX1 FX2 FX3 FX4 OUT};
    SHAPE2 -> {RES1 RES2 FILT1 FILT2 SHAPE1 MIX1 MIX2 FX1 FX2 FX3 FX4 OUT};
    MIX1 -> {RES1 RES2 FILT1 FILT2 SHAPE1 SHAPE2 MIX2 FX1 FX2 FX3 FX4 OUT};
    MIX2 -> {RES1 RES2 FILT1 FILT2 SHAPE1 SHAPE2 MIX1 FX1 FX2 FX3 FX4 OUT};
    // the global tail -> only another effects slot or the OUT bus
    FX1 -> {FX2 FX3 FX4 OUT};
    FX2 -> {FX1 FX3 FX4 OUT};
    FX3 -> {FX1 FX2 FX4 OUT};
    FX4 -> {FX1 FX2 FX3 OUT};
}
